{
  "id": "rsa-encryption-key",
  "name": "rsa-encryption-key",
  "providerId": "java-keystore",
  "providerType": "org.keycloak.keys.KeyProvider",
  "config": {
    "keystore": [
      "$KEYSTORE_PATH"
    ],
    "keystoreType": [
      "$KEYSTORE_TYPE"
    ],
    "keystorePassword": [
      "$KEYSTORE_PASSWORD"
    ],
    "keyAlias":[
      "$KEYSTORE_ALIASES_RSA_ENC_KEY"
    ],
    "keyPassword": [
      "$KEYSTORE_PASSWORD"
    ],
    "active": ["true"],
    "priority": ["200"],
    "enabled": ["true"],
    "algorithm": ["RSA-OAEP"],
    "keyUse": ["enc"]
  }
}
