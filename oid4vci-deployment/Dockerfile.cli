FROM eclipse-temurin:21-jdk-jammy

WORKDIR /workspace

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bash \
      curl \
      git \
      jq \
      openssl \
      ca-certificates \
      procps \
      xxd \
      coreutils \
      unzip \
      uuid-runtime \
      gettext-base \
      gnupg \
      lsb-release && \
    rm -rf /var/lib/apt/lists/*

# Install Docker CLI and Docker Compose plugin from Docker's official repository
RUN install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      docker-ce-cli \
      docker-compose-plugin && \
    rm -rf /var/lib/apt/lists/*

# yq for YAML processing (matches behavior of helper.sh)
RUN curl -L https://github.com/mikefarah/yq/releases/download/v4.44.1/yq_linux_amd64 -o /usr/bin/yq && \
    chmod +x /usr/bin/yq

# figlet is optional; install for nicer CLI banners
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends figlet && \
    rm -rf /var/lib/apt/lists/*

# Default command; actual entrypoint/command is provided by docker-compose
CMD ["bash"]
